{
  "name": "cpp",
  "version": "1.0.0",
  "description": "C++17 projects (g++) with clangd / VS Code / Zed / Neovim include paths preconfigured",
  "type": "language",
  "aliases": [
    "c++",
    "cxx",
    "g++"
  ],
  "provides": {
    "languages": [
      "cpp"
    ],
    "libs": [
      "m",
      "pthread",
      "curl",
      "sqlite3",
      "SDL2",
      "fmt",
      "boost_system",
      "z"
    ]
  },
  "dependencies": [],
  "dirs": [
    "src",
    "include",
    "libs/include",
    "libs/lib"
  ],
  "files": [
    {
      "src": "templates/main.cpp",
      "dest": "src/main.cpp"
    },
    {
      "src": "templates/gitignore",
      "dest": ".gitignore",
      "merge": "append"
    },
    {
      "src": "templates/compile_flags.txt",
      "dest": "compile_flags.txt",
      "merge": "append"
    },
    {
      "src": "templates/libs-README.md",
      "dest": "libs/README.md"
    },
    {
      "src": "templates/vscode-settings.json",
      "dest": ".vscode/settings.json",
      "merge": "json"
    },
    {
      "src": "templates/vscode-c_cpp_properties.json",
      "dest": ".vscode/c_cpp_properties.json",
      "merge": "json"
    },
    {
      "src": "templates/vscode-extensions.json",
      "dest": ".vscode/extensions.json",
      "merge": "json"
    },
    {
      "src": "templates/zed-settings.json",
      "dest": ".zed/settings.json",
      "merge": "json"
    },
    {
      "src": "templates/nvim.lua",
      "dest": ".nvim.lua",
      "merge": "append"
    }
  ],
  "build": {
    "requires": [
      "g++"
    ],
    "problem_matcher": "$gcc",
    "build_sh": [
      "mkdir -p build",
      "g++ -std=c++17 -Wall -Wextra -g -Iinclude -Ilibs/include $(find src \\( -name '*.cpp' -o -name '*.cc' -o -name '*.cxx' \\)) -o build/{{name}} -Llibs/lib {{libs_link}}"
    ],
    "build_bat": [
      "if not exist build mkdir build",
      "g++ -std=c++17 -Wall -Wextra -g -Iinclude -Ilibs\\include src\\*.cpp -o build\\{{name}}.exe -Llibs\\lib {{libs_link}}"
    ],
    "run_sh": [
      "LD_LIBRARY_PATH=\"libs/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" ./build/{{name}}"
    ],
    "run_bat": [
      "set \"PATH=%CD%\\libs\\lib;%PATH%\"",
      "build\\{{name}}.exe"
    ],
    "clean_sh": [
      "rm -rf build"
    ],
    "clean_bat": [
      "if exist build rmdir /s /q build"
    ]
  },
  "min_prox_version": "0.1.0",
  "checksum": "sha256:5fb91877391ac0f43063778eb1c793fa484b9e476aaa1814abe6beeb2ae4a2bd"
}
